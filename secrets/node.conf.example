# ARMOR-HMI - the FIRST settings of one panel. Copy to secrets/<node-id>.conf and edit (that copy is git-ignored).
#
# These values only seed a freshly flashed panel. After the first start the panel's own web page holds its settings (Wi-Fi, server, screen, sound, users) in flash, and this file
# no longer matters to that panel. A build with none of the identity lines is a generic image that is configured entirely from the web page.

CONFIG_ARMOR_NODE_ID="hmi-salon"
CONFIG_ARMOR_MQTT_URI="mqtt://192.168.0.180:18883"
CONFIG_ARMOR_MQTT_USERNAME="hmi-node-hmi-salon"
CONFIG_ARMOR_MQTT_PASSWORD="the password printed once by mqtt_identity.sh add hmi-node hmi-salon"

# The code that lets the first administrator be created from the panel's web page (8 to 32 characters). Empty: a new random code at every start, shown on the USB console every
# 15 seconds.
CONFIG_ARMOR_SETUP_CODE="K7M2QX9PTR"
