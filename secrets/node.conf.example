# ARMOR-NODE-HMI - the FIRST settings of one panel. Copy to secrets/<node-id>.conf and edit (that copy is git-ignored).
#
# These values only seed a freshly flashed panel. After the first start the panel's own web page holds its settings (Wi-Fi, server, screen, sound, users) in flash, and this file
# no longer matters to that panel. A build with none of the identity lines is a generic image that is configured entirely from the web page.

CONFIG_ARMOR_NODE_ID="hmi-salon"
# replace with the address of your broker (192.0.2.x is reserved for documentation)
CONFIG_ARMOR_MQTT_URI="mqtt://192.0.2.10:18883"
CONFIG_ARMOR_MQTT_USERNAME="hmi-node-hmi-salon"
CONFIG_ARMOR_MQTT_PASSWORD="the password printed once by mqtt_identity.sh add hmi-node hmi-salon"

# The code that lets the first administrator be created from the panel's web page (8 to 32 characters). Empty: a random code made the first time and kept in the node, shown on the USB console every
# 15 seconds.
# Leave it empty here: a code written in a file that is copied is a code that everybody who copies it has (it is also the password of the set-up access point).
CONFIG_ARMOR_SETUP_CODE=""
